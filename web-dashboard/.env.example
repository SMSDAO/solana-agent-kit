# Environment Variables for Solana Agent Kit Dashboard
# Copy this file to .env.local and fill in your values

# ─── Required ─────────────────────────────────────────────────────────────────

# NextAuth.js — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# ─── Solana RPC ────────────────────────────────────────────────────────────────
# Override with a premium RPC provider for production (Helius, Triton, etc.)
NEXT_PUBLIC_SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_TESTNET_RPC=https://api.testnet.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# Default network shown in the dashboard (mainnet-beta | testnet | devnet)
NEXT_PUBLIC_DEFAULT_NETWORK=mainnet-beta

# ─── Optional: OAuth Providers ────────────────────────────────────────────────
# GitHub OAuth — create at https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# ─── Optional: Version display ────────────────────────────────────────────────
NEXT_PUBLIC_SDK_VERSION=1.4.8
NEXT_PUBLIC_DASHBOARD_VERSION=1.0.0

# ─── Optional: Feature Flags ──────────────────────────────────────────────────
# Set to true to show demo credentials on the admin login page (dev only)
NEXT_PUBLIC_ADMIN_DEMO_MODE=false

# ─── Optional: Admin Wallets (legacy) ─────────────────────────────────────────
# Comma-separated list of admin wallet addresses (no spaces)
NEXT_PUBLIC_ADMIN_WALLETS=

# ─── Optional: External APIs ──────────────────────────────────────────────────
OPENAI_API_KEY=
HELIUS_API_KEY=
COINGECKO_API_KEY=

